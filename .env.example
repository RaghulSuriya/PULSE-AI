# PULSE AI Master Environment Variables

# Backend Environment
ENVIRONMENT=development
SECRET_KEY=pulse_ai_super_secret_jwt_key_change_in_production_32bytes

# Database Configuration (Async SQLite for dev zero-setup, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./pulse.db
# DATABASE_URL=postgresql+asyncpg://pulse_user:pulse_password@localhost:5432/pulse_db

# Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# AI Model Provider Configuration
AI_PROVIDER=openai # Options: openai, gemini, anthropic
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o-mini # Options: gpt-4o-mini, gemini-1.5-flash, claude-3-haiku-20240307

# News API Configuration (Optional for Daily Brief live feed)
NEWS_API_KEY=your_news_api_key_here

# Frontend Next.js API Base Proxy
NEXT_PUBLIC_API_URL=http://localhost:8000
